<% layout('layouts/main') %>

<main class="home-page">
    <section class="hero">
        <div class="hero-content">
            <div class="hero-badge">AI-Powered Document Analysis</div>
            <h1 class="hero-title">Turn Documents Into<br><span class="gradient-text">Actionable Plans</span></h1>
            <p class="hero-subtitle">Upload any document — assignments, project briefs, meeting notes, circulars, or work instructions — and let AI extract every task, deadline, priority, and dependency into a structured action plan.</p>
        </div>
        <div class="hero-flow">
            <div class="flow-item"><span class="flow-icon">📄</span><span>Upload Document</span></div>
            <div class="flow-arrow">→</div>
            <div class="flow-item"><span class="flow-icon">🤖</span><span>AI Analysis</span></div>
            <div class="flow-arrow">→</div>
            <div class="flow-item"><span class="flow-icon">✅</span><span>Action Plan</span></div>
        </div>
    </section>

    <section class="upload-section">
        <div class="upload-card">
            <form id="uploadForm" action="/documents/upload" method="POST" enctype="multipart/form-data">
                <div class="drop-zone" id="dropZone">
                    <div class="drop-zone-inner">
                        <div class="drop-icon">
                            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M24 32V16M24 16L18 22M24 16L30 22" stroke="#6366f1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M12 36h24" stroke="#6366f1" stroke-width="2.5" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <h3 class="drop-title">Drag & drop your document here</h3>
                        <p class="drop-subtitle">or click to browse files</p>
                        <div class="drop-formats">
                            <span class="format-badge">PDF</span>
                            <span class="format-badge">DOCX</span>
                            <span class="format-badge">TXT</span>
                        </div>
                        <p class="drop-limit">Maximum file size: 20MB</p>
                    </div>
                    <input type="file" id="fileInput" name="document" accept=".pdf,.docx,.txt" class="file-input-hidden">
                </div>

                <div class="file-preview" id="filePreview" style="display:none;">
                    <div class="file-preview-inner">
                        <div class="file-icon-wrap" id="fileIconWrap"></div>
                        <div class="file-meta">
                            <p class="file-name" id="fileName"></p>
                            <p class="file-size" id="fileSize"></p>
                        </div>
                        <button type="button" class="remove-file-btn" id="removeFile">✕</button>
                    </div>
                </div>

                <div class="upload-error" id="uploadError" style="display:none;"></div>

                <button type="submit" class="upload-btn" id="uploadBtn" disabled>
                    <span class="btn-text">Analyze Document</span>
                    <span class="btn-arrow">→</span>
                </button>
            </form>
        </div>
    </section>

    <section class="features-section">
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">🎯</div>
                <h4>Smart Task Extraction</h4>
                <p>AI distinguishes between actionable tasks and informational content — no false positives.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📅</div>
                <h4>Deadline Intelligence</h4>
                <p>Natural language dates like "next Friday" or "within 7 days" are parsed and resolved.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🔗</div>
                <h4>Dependency Mapping</h4>
                <p>Understand which tasks depend on others and build a logical execution order.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📋</div>
                <h4>Source Traceability</h4>
                <p>Every extracted task links back to the exact text in your document.</p>
            </div>
        </div>
    </section>
</main>